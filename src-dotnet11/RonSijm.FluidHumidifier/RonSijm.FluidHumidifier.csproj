<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>preview</LangVersion>
    <Version>$(FluidHumidifierPackageVersion)</Version>
    <Title>RonSijm.FluidHumidifier</Title>
    <Description>A fluent factory API for composing AWS CloudFormation resources with RonSijm.Humidifier.</Description>
    <Authors>Ron Sijm</Authors>
    <Copyright>Ron Sijm</Copyright>
    <PackageId>RonSijm.FluidHumidifier</PackageId>
    <PackageTags>aws;cloudformation;humidifier;fluent</PackageTags>
    <PackageIconUrl>https://raw.githubusercontent.com/jakejscott/humidifier/master/img/humidifier.png</PackageIconUrl>
    <PackageProjectUrl>https://github.com/RonSijm/RonSijm.FluidHumidifier</PackageProjectUrl>
    <RepositoryUrl>https://github.com/RonSijm/RonSijm.FluidHumidifier</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <DebugType>none</DebugType>
  </PropertyGroup>

	<ItemGroup>
		<PackageReference Include="JetBrains.Annotations" Version="2024.2.0" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
		<PackageReference Include="RonSijm.Humidifier" Version="$(HumidifierPackageVersion)" Condition="'$(UseHumidifierProjectReference)' != 'true'" />
	</ItemGroup>
	
	<ItemGroup Condition="'$(UseHumidifierProjectReference)' == 'true'">
	  <ProjectReference Include="$(HumidifierRepositoryRoot)\$(HumidifierSourceDirectory)\Humidifier\Humidifier.csproj" AdditionalProperties="PackageVersion=$(HumidifierPackageVersion)" />
	</ItemGroup>

	<ItemGroup>
	  <None Include="..\..\README.md" Pack="true" PackagePath="\" />
	</ItemGroup>
	
	<ItemGroup>
	  <Folder Include="Factories\Gen\EC2\Extensions\" />
	</ItemGroup>


</Project>
