    "FruitVendorprodpuma": {
      "Type": "AWS::ECS::Service",
      "Properties": {
        "PlatformVersion": "1.4.0",
        "CapacityProviderStrategy": [
          {
            "CapacityProvider": "FARGATE",
            "Weight": 1
          }
        ],
        "SchedulingStrategy": "REPLICA",
        "NetworkConfiguration": {
          "AwsvpcConfiguration": {
            "SecurityGroups": [
              {
                "Fn::ImportValue": "DockerSecurityGroup"
              }
            ],
            "Subnets": [
              {
                "Fn::ImportValue": "DockerSubnetAZA"
              },
              {
                "Fn::ImportValue": "DockerSubnetAZB"
              },
              {
                "Fn::ImportValue": "DockerSubnetAZC"
              }
            ],
            "AssignPublicIp": "ENABLED"
          }
        },
        "Tags": [
          {
            "Key": "Name",
            "Value": "FruitVendor-prod-puma"
          }
        ],
        "EnableExecuteCommand": true,
        "Cluster": {
          "Ref": "FruitVendorprodCluster"
        },
        "LoadBalancers": [
          {
            "TargetGroupArn": {
              "Fn::ImportValue": "FruitVendorPumaLBprodLBTG"
            },
            "ContainerName": "prod-puma-ContainerDefinition",
            "ContainerPort": 3000
          }
        ],
        "DesiredCount": 1,
        "DeploymentController": {
          "Type": "ECS"
        },
        "TaskDefinition": {
          "Ref": "prodpumaprodTaskDefinition"
        },
        "ServiceName": "FruitVendor-prod-puma",
        "DeploymentConfiguration": {
          "DeploymentCircuitBreaker": {
            "Enable": false,
            "Rollback": false
          },
          "MaximumPercent": 200,
          "MinimumHealthyPercent": 100
        }
      },
      "CreationPolicy": {
        "ResourceSignal": {
          "Count": 0,
          "Timeout": "PT1S"
        }
      }
    },
