    "prodpumaprodTaskDefinition": {
      "Type": "AWS::ECS::TaskDefinition",
      "Properties": {
        "TaskRoleArn": {
          "Fn::ImportValue": "ECRprodtoassetsAccessRole"
        },
        "Memory": "3072",
        "Cpu": "1024",
        "RequiresCompatibilities": [
          "FARGATE"
        ],
        "NetworkMode": "awsvpc",
        "ExecutionRoleArn": {
          "Fn::ImportValue": "ECRprodtoassetsAccessRole"
        },
        "RuntimePlatform": {
          "OperatingSystemFamily": "LINUX",
          "CpuArchitecture": "X86_64"
        },
        "Volumes": [
          {
            "Name": "log"
          }
        ],
        "ContainerDefinitions": [
          {
            "HealthCheck": {
              "Command": [
                "CMD-SHELL",
                "exit 0"
              ],
              "Timeout": 30,
              "Retries": 3,
              "Interval": 30,
              "StartPeriod": 1
            },
            "Image": "111111111111.dkr.ecr.eu-central-1.amazonaws.com/fruitvendor-webapp:latest-prod",
            "Essential": true,
            "LogConfiguration": {
              "Options": {
                "awslogs-group": "/ecs/prod-puma",
                "awslogs-create-group": "true",
                "awslogs-region": "eu-central-1",
                "awslogs-stream-prefix": "ecs"
              },
              "LogDriver": "awslogs"
            },
            "EnvironmentFiles": [
              {
                "Type": "s3",
                "Value": "arn:aws:s3:::fruitvendor-prod-webapp-environmentvariables/fruitvendor-webapp.env"
              }
            ],
            "Name": "prod-puma-ContainerDefinition",
            "MountPoints": [
              {
                "ReadOnly": false,
                "SourceVolume": "log",
                "ContainerPath": "/webapp/log"
              }
            ],
            "PortMappings": [
              {
                "AppProtocol": "http",
                "HostPort": "3000",
                "ContainerPort": "3000",
                "Protocol": "tcp"
              }
            ]
          }
        ],
        "Family": "prod-puma",
        "Tags": [
          {
            "Key": "Name",
            "Value": "prod-puma-prod-TaskDefinition"
          }
        ]
      }
    },
