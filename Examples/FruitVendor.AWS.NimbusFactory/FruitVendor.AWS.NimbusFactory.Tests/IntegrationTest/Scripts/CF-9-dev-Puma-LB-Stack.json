{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "CloudFormation Stack For Puma-LB For dev Environment",
  "Resources": {
    "FruitVendorPumaLBdevLB": {
      "Type": "AWS::ElasticLoadBalancingV2::LoadBalancer",
      "Properties": {
        "IpAddressType": "ipv4",
        "SecurityGroups": [
          {
            "Fn::ImportValue": "PumaLBSecurityGroup"
          }
        ],
        "LoadBalancerAttributes": [
          {
            "Value": "60",
            "Key": "idle_timeout.timeout_seconds"
          },
          {
            "Value": "false",
            "Key": "deletion_protection.enabled"
          },
          {
            "Value": "true",
            "Key": "routing.http2.enabled"
          },
          {
            "Value": "false",
            "Key": "routing.http.drop_invalid_header_fields.enabled"
          },
          {
            "Value": "true",
            "Key": "routing.http.xff_client_port.enabled"
          },
          {
            "Value": "true",
            "Key": "routing.http.preserve_host_header.enabled"
          },
          {
            "Value": "append",
            "Key": "routing.http.xff_header_processing.mode"
          },
          {
            "Value": "true",
            "Key": "load_balancing.cross_zone.enabled"
          },
          {
            "Value": "defensive",
            "Key": "routing.http.desync_mitigation_mode"
          },
          {
            "Value": "3600",
            "Key": "client_keep_alive.seconds"
          },
          {
            "Value": "false",
            "Key": "waf.fail_open.enabled"
          },
          {
            "Value": "false",
            "Key": "routing.http.x_amzn_tls_version_and_cipher_suite.enabled"
          },
          {
            "Value": "true",
            "Key": "access_logs.s3.enabled"
          },
          {
            "Value": "aws-fruitvendor-dev-logging",
            "Key": "access_logs.s3.bucket"
          },
          {
            "Value": "LoadBalancerLogs/fruitvendor/AccessLogs",
            "Key": "access_logs.s3.prefix"
          },
          {
            "Value": "true",
            "Key": "connection_logs.s3.enabled"
          },
          {
            "Value": "aws-fruitvendor-dev-logging",
            "Key": "connection_logs.s3.bucket"
          },
          {
            "Value": "LoadBalancerLogs/fruitvendor/ConnectionLogs",
            "Key": "connection_logs.s3.prefix"
          }
        ],
        "Subnets": [
          {
            "Fn::ImportValue": "PumaLBSubnetAZA"
          },
          {
            "Fn::ImportValue": "PumaLBSubnetAZB"
          },
          {
            "Fn::ImportValue": "PumaLBSubnetAZC"
          }
        ],
        "Type": "application",
        "Scheme": "internet-facing",
        "Tags": [
          {
            "Key": "Name",
            "Value": "FruitVendor-Puma-LB-dev-LB"
          }
        ],
        "Name": "FruitVendor-Puma-LB-dev-LB"
      }
    },
    "FruitVendorPumaLBdevLBListener": {
      "Type": "AWS::ElasticLoadBalancingV2::Listener",
      "Properties": {
        "LoadBalancerArn": {
          "Fn::GetAtt": [
            "FruitVendorPumaLBdevLB",
            "LoadBalancerArn"
          ]
        },
        "DefaultActions": [
          {
            "Order": 1,
            "TargetGroupArn": {
              "Ref": "FruitVendorPumaLBdevLBTG"
            },
            "Type": "forward"
          }
        ],
        "Port": 443,
        "Certificates": [
          {
            "CertificateArn": "arn:aws:acm:eu-central-1:333333333333:certificate/00000000-0000-0000-0000-000000000004"
          }
        ],
        "Protocol": "HTTPS"
      },
      "DependsOn": [
        "FruitVendorPumaLBdevLB"
      ]
    },
    "FruitVendorPumaLBdevLBTG": {
      "Type": "AWS::ElasticLoadBalancingV2::TargetGroup",
      "Properties": {
        "HealthCheckIntervalSeconds": 300,
        "Matcher": {
          "HttpCode": "200-499"
        },
        "HealthCheckPath": "/up",
        "Port": 3000,
        "HealthCheckEnabled": true,
        "UnhealthyThresholdCount": 2,
        "HealthCheckTimeoutSeconds": 30,
        "Name": "FruitVendor-Puma-LB-dev-LB-TG",
        "VpcId": {
          "Fn::ImportValue": "FruitVendorInfrastructure"
        },
        "HealthyThresholdCount": 5,
        "HealthCheckProtocol": "HTTP",
        "TargetGroupAttributes": [
          {
            "Value": "off",
            "Key": "target_group_health.unhealthy_state_routing.minimum_healthy_targets.percentage"
          },
          {
            "Value": "300",
            "Key": "deregistration_delay.timeout_seconds"
          },
          {
            "Value": "lb_cookie",
            "Key": "stickiness.type"
          },
          {
            "Value": "86400",
            "Key": "stickiness.lb_cookie.duration_seconds"
          },
          {
            "Value": "0",
            "Key": "slow_start.duration_seconds"
          },
          {
            "Value": "86400",
            "Key": "stickiness.app_cookie.duration_seconds"
          },
          {
            "Value": "off",
            "Key": "target_group_health.dns_failover.minimum_healthy_targets.percentage"
          },
          {
            "Value": "use_load_balancer_configuration",
            "Key": "load_balancing.cross_zone.enabled"
          },
          {
            "Value": "round_robin",
            "Key": "load_balancing.algorithm.type"
          },
          {
            "Value": "1",
            "Key": "target_group_health.unhealthy_state_routing.minimum_healthy_targets.count"
          },
          {
            "Value": "false",
            "Key": "stickiness.enabled"
          },
          {
            "Value": "1",
            "Key": "target_group_health.dns_failover.minimum_healthy_targets.count"
          },
          {
            "Value": "off",
            "Key": "load_balancing.algorithm.anomaly_mitigation"
          },
          {
            "Value": "",
            "Key": "stickiness.app_cookie.cookie_name"
          }
        ],
        "TargetType": "ip",
        "HealthCheckPort": "3000",
        "Protocol": "HTTP",
        "Tags": [
          {
            "Key": "Name",
            "Value": "FruitVendor-Puma-LB-dev-LB-TG"
          }
        ]
      }
    },
    "loadbalancerdevfruitvendorcom": {
      "Type": "AWS::Route53::RecordSet",
      "Properties": {
        "HostedZoneName": "dev-fruitvendor.example.",
        "Name": "loadbalancer.dev-fruitvendor.example",
        "ResourceRecords": [
          {
            "Fn::GetAtt": [
              "FruitVendorPumaLBdevLB",
              "DNSName"
            ]
          }
        ],
        "TTL": 300,
        "Type": "CNAME"
      }
    }
  },
  "Outputs": {
    "FruitVendorPumaLBdevLBTG": {
      "Value": {
        "Ref": "FruitVendorPumaLBdevLBTG"
      },
      "Export": {
        "Name": {
          "Fn::Sub": "FruitVendorPumaLBdevLBTG"
        }
      }
    }
  }
}