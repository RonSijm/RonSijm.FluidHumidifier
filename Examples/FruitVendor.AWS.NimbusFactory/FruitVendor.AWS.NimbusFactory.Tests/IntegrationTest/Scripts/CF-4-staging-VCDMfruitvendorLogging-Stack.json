{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "CloudFormation Stack For VCDM fruitvendor Logging For staging Environment",
  "Resources": {
    "fruitvendorCloudTrailLogging": {
      "Type": "AWS::CloudTrail::Trail",
      "Properties": {
        "IncludeGlobalServiceEvents": true,
        "EventSelectors": [
          {
            "IncludeManagementEvents": true,
            "ReadWriteType": "All",
            "ExcludeManagementEventSources": [
              "kms.amazonaws.com"
            ]
          }
        ],
        "KMSKeyId": {
          "Fn::Sub": "arn:aws:kms:${AWS::Region}:${AWS::AccountId}:alias/KMS-staging-CMK"
        },
        "S3KeyPrefix": "CloudTrailLogs",
        "TrailName": "fruitvendor-CloudTrail-Logging",
        "IsMultiRegionTrail": true,
        "S3BucketName": {
          "Ref": "awsfruitvendorstaginglogging"
        },
        "Tags": [
          {
            "Key": "Name",
            "Value": "fruitvendor-CloudTrail-Logging"
          }
        ],
        "IsLogging": true
      },
      "DependsOn": [
        "awsfruitvendorstagingloggingpolicy"
      ]
    },
    "fruitvendorAWSConfigurationRecorder": {
      "Type": "AWS::Config::ConfigurationRecorder",
      "Properties": {
        "Name": "fruitvendor-AWS-Configuration-Recorder",
        "RecordingGroup": {
          "AllSupported": true,
          "IncludeGlobalResourceTypes": true
        },
        "RoleARN": {
          "Fn::GetAtt": [
            "AWSConfigLoggingfruitvendorRole",
            "Arn"
          ]
        }
      }
    },
    "fruitvendorAWSConfigurationDeliveryChannel": {
      "Type": "AWS::Config::DeliveryChannel",
      "Properties": {
        "ConfigSnapshotDeliveryProperties": {
          "DeliveryFrequency": "TwentyFour_Hours"
        },
        "Name": "fruitvendor-AWS-Configuration-DeliveryChannel",
        "S3BucketName": {
          "Ref": "awsfruitvendorstaginglogging"
        },
        "S3KeyPrefix": "AWSConfig"
      }
    },
    "fruitvendorCloudTrailLoggingQueue": {
      "Type": "AWS::SQS::Queue",
      "Properties": {
        "SqsManagedSseEnabled": true,
        "QueueName": "fruitvendor-CloudTrail-Logging-Queue",
        "Tags": [
          {
            "Key": "Name",
            "Value": "fruitvendor-CloudTrail-Logging-Queue"
          }
        ]
      }
    },
    "fruitvendorLoadBalancerLoggingQueue": {
      "Type": "AWS::SQS::Queue",
      "Properties": {
        "SqsManagedSseEnabled": true,
        "QueueName": "fruitvendor-LoadBalancer-Logging-Queue",
        "Tags": [
          {
            "Key": "Name",
            "Value": "fruitvendor-LoadBalancer-Logging-Queue"
          }
        ]
      }
    },
    "fruitvendorGuardDutyLoggingQueue": {
      "Type": "AWS::SQS::Queue",
      "Properties": {
        "SqsManagedSseEnabled": true,
        "QueueName": "fruitvendor-GuardDuty-Logging-Queue",
        "Tags": [
          {
            "Key": "Name",
            "Value": "fruitvendor-GuardDuty-Logging-Queue"
          }
        ]
      }
    },
    "GSOCSLMLoggingfruitvendorRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "RoleName": "GSOC-SLM-Logging-fruitvendor-Role",
        "Policies": [
          {
            "PolicyName": "GSOC-SLM-Logging-fruitvendor-Role-Policy",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Sid": "AllowGetObjectsFromBucket",
                  "Effect": "Allow",
                  "Action": [
                    "s3:GetObject",
                    "s3:ListBucket"
                  ],
                  "Resource": [
                    "arn:aws:s3:::aws-fruitvendor-staging-logging/*",
                    "arn:aws:s3:::aws-fruitvendor-staging-logging"
                  ]
                },
                {
                  "Sid": "AllowCloudTrailLogsQueueToUseSQS",
                  "Effect": "Allow",
                  "Action": [
                    "sqs:*"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "fruitvendorCloudTrailLoggingQueue",
                      "Arn"
                    ]
                  }
                },
                {
                  "Sid": "AllowLoadBalancerLogsQueueToUseSQS",
                  "Effect": "Allow",
                  "Action": [
                    "sqs:*"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "fruitvendorLoadBalancerLoggingQueue",
                      "Arn"
                    ]
                  }
                },
                {
                  "Sid": "AllowGuardDutyLogsQueueToUseSQS",
                  "Effect": "Allow",
                  "Action": [
                    "sqs:*"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "fruitvendorGuardDutyLoggingQueue",
                      "Arn"
                    ]
                  }
                },
                {
                  "Sid": "AllowUseKMSKey",
                  "Effect": "Allow",
                  "Action": [
                    "kms:Decrypt",
                    "kms:GenerateDataKey"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:aws:kms:${AWS::Region}:${AWS::AccountId}:alias/KMS-staging-CMK"
                  }
                }
              ]
            }
          }
        ],
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "AWS": "arn:aws:iam::900000000001:user/example-security-logs-stage"
              },
              "Action": [
                "sts:AssumeRole"
              ]
            }
          ]
        },
        "Tags": [
          {
            "Key": "Name",
            "Value": "GSOC-SLM-Logging-fruitvendor-Role"
          }
        ]
      }
    },
    "AWSConfigLoggingfruitvendorRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "RoleName": "AWSConfig-Logging-fruitvendor-Role",
        "Policies": [
          {
            "PolicyName": "AWSConfig-Logging-fruitvendor-Role-Policy",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Sid": "AllowAWSConfigGetObjectsFromBucket",
                  "Effect": "Allow",
                  "Action": [
                    "s3:PutObject",
                    "s3:PutObjectAcl",
                    "s3:GetBucketAcl",
                    "s3:GetBucketLocation"
                  ],
                  "Resource": [
                    "arn:aws:s3:::aws-fruitvendor-staging-logging/*",
                    "arn:aws:s3:::aws-fruitvendor-staging-logging"
                  ]
                },
                {
                  "Sid": "AllowAWSConfigOtherThings",
                  "Effect": "Allow",
                  "Action": [
                    "ec2:Describe*",
                    "s3:ListBucket",
                    "rds:Describe*",
                    "rds:ListTagsForResource",
                    "cloudtrail:DescribeTrails",
                    "cloudtrail:GetTrailStatus",
                    "cloudtrail:ListTags",
                    "cloudtrail:ListTrails"
                  ],
                  "Resource": "*"
                }
              ]
            }
          }
        ],
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "config.amazonaws.com"
              },
              "Action": [
                "sts:AssumeRole"
              ],
              "Condition": {
                "StringEquals": {
                  "AWS:SourceAccount": "444444444444"
                }
              }
            }
          ]
        },
        "Tags": [
          {
            "Key": "Name",
            "Value": "AWSConfig-Logging-fruitvendor-Role"
          }
        ]
      }
    },
    "awsfruitvendorstaginglogging": {
      "Type": "AWS::S3::Bucket",
      "Properties": {
        "NotificationConfiguration": {
          "QueueConfigurations": [
            {
              "Filter": {
                "S3Key": {
                  "Rules": [
                    {
                      "Value": "CloudTrailLogs/",
                      "Name": "prefix"
                    }
                  ]
                }
              },
              "Event": "s3:ObjectCreated:*",
              "Queue": {
                "Fn::GetAtt": [
                  "fruitvendorCloudTrailLoggingQueue",
                  "Arn"
                ]
              }
            },
            {
              "Filter": {
                "S3Key": {
                  "Rules": [
                    {
                      "Value": "LoadBalancerLogs/",
                      "Name": "prefix"
                    }
                  ]
                }
              },
              "Event": "s3:ObjectCreated:*",
              "Queue": {
                "Fn::GetAtt": [
                  "fruitvendorLoadBalancerLoggingQueue",
                  "Arn"
                ]
              }
            },
            {
              "Filter": {
                "S3Key": {
                  "Rules": [
                    {
                      "Value": "GuardDutyLogs/",
                      "Name": "prefix"
                    }
                  ]
                }
              },
              "Event": "s3:ObjectCreated:*",
              "Queue": {
                "Fn::GetAtt": [
                  "fruitvendorGuardDutyLoggingQueue",
                  "Arn"
                ]
              }
            }
          ]
        },
        "LifecycleConfiguration": {
          "Rules": [
            {
              "Status": "Enabled",
              "Transitions": [
                {
                  "StorageClass": "STANDARD_IA",
                  "TransitionInDays": 30
                }
              ],
              "ExpirationInDays": 120,
              "Id": "ex_year_trans_mo"
            }
          ]
        },
        "BucketName": "aws-fruitvendor-staging-logging",
        "Tags": [
          {
            "Key": "Name",
            "Value": "aws-fruitvendor-staging-logging"
          }
        ]
      },
      "DependsOn": [
        "fruitvendorCloudTrailLoggingQueue",
        "fruitvendorLoadBalancerLoggingQueue",
        "fruitvendorGuardDutyLoggingQueue"
      ]
    },
    "awsfruitvendorstagingloggingpolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": {
          "Ref": "awsfruitvendorstaginglogging"
        },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "AWSCloudTrailAclCheck",
              "Effect": "Allow",
              "Principal": {
                "Service": "cloudtrail.amazonaws.com"
              },
              "Action": [
                "s3:GetBucketAcl"
              ],
              "Resource": [
                "arn:aws:s3:::aws-fruitvendor-staging-logging"
              ],
              "Condition": {
                "StringLike": {
                  "AWS:SourceArn": "arn:aws:cloudtrail:eu-central-1:444444444444:trail/*"
                }
              }
            },
            {
              "Sid": "AWSCloudTrailWrite",
              "Effect": "Allow",
              "Principal": {
                "Service": "cloudtrail.amazonaws.com"
              },
              "Action": [
                "s3:PutObject"
              ],
              "Resource": "arn:aws:s3:::aws-fruitvendor-staging-logging/*",
              "Condition": {
                "StringEquals": {
                  "s3:x-amz-acl": "bucket-owner-full-control"
                }
              }
            },
            {
              "Sid": "AWSConfigWrite",
              "Effect": "Allow",
              "Principal": {
                "Service": "config.amazonaws.com"
              },
              "Action": [
                "s3:PutObject"
              ],
              "Resource": "arn:aws:s3:::aws-fruitvendor-staging-logging/*",
              "Condition": {
                "StringEquals": {
                  "s3:x-amz-acl": "bucket-owner-full-control"
                }
              }
            },
            {
              "Sid": "Allow LoadBalancer Logging Account",
              "Effect": "Allow",
              "Principal": {
                "AWS": "arn:aws:iam::900000000002:root"
              },
              "Action": "s3:PutObject",
              "Resource": "arn:aws:s3:::aws-fruitvendor-staging-logging/*"
            },
            {
              "Sid": "Allow GuardDuty Get Bucket Location",
              "Effect": "Allow",
              "Principal": {
                "Service": "guardduty.amazonaws.com"
              },
              "Action": [
                "s3:GetBucketLocation",
                "s3:ListBucket"
              ],
              "Resource": "arn:aws:s3:::aws-fruitvendor-staging-logging",
              "Condition": {
                "StringEquals": {
                  "aws:SourceAccount": {
                    "Fn::Sub": "${AWS::AccountId}"
                  }
                }
              }
            },
            {
              "Sid": "Allow GuardDuty PutObject",
              "Effect": "Allow",
              "Principal": {
                "Service": "guardduty.amazonaws.com"
              },
              "Action": "s3:PutObject",
              "Resource": "arn:aws:s3:::aws-fruitvendor-staging-logging/*",
              "Condition": {
                "StringEquals": {
                  "aws:SourceAccount": {
                    "Fn::Sub": "${AWS::AccountId}"
                  }
                }
              }
            }
          ]
        }
      }
    },
    "fruitvendorCloudTrailLoggingQueuePolicy": {
      "Type": "AWS::SQS::QueuePolicy",
      "Properties": {
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "s3.amazonaws.com"
              },
              "Action": [
                "SQS:SendMessage"
              ],
              "Resource": "arn:aws:sqs:eu-central-1:444444444444:fruitvendor-CloudTrail-Logging-Queue"
            }
          ]
        },
        "Queues": [
          {
            "Ref": "fruitvendorCloudTrailLoggingQueue"
          }
        ]
      }
    },
    "fruitvendorLoadBalancerLoggingQueuePolicy": {
      "Type": "AWS::SQS::QueuePolicy",
      "Properties": {
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "s3.amazonaws.com"
              },
              "Action": [
                "SQS:SendMessage"
              ],
              "Resource": "arn:aws:sqs:eu-central-1:444444444444:fruitvendor-LoadBalancer-Logging-Queue"
            }
          ]
        },
        "Queues": [
          {
            "Ref": "fruitvendorLoadBalancerLoggingQueue"
          }
        ]
      }
    },
    "fruitvendorGuardDutyLoggingQueuePolicy": {
      "Type": "AWS::SQS::QueuePolicy",
      "Properties": {
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "s3.amazonaws.com"
              },
              "Action": [
                "SQS:SendMessage"
              ],
              "Resource": "arn:aws:sqs:eu-central-1:444444444444:fruitvendor-GuardDuty-Logging-Queue"
            }
          ]
        },
        "Queues": [
          {
            "Ref": "fruitvendorGuardDutyLoggingQueue"
          }
        ]
      }
    }
  }
}