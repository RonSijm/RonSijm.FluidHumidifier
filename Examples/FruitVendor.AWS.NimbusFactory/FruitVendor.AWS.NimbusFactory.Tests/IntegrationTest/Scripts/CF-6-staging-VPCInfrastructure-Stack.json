{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "CloudFormation Stack For VPC Infrastructure For staging Environment",
  "Resources": {
    "internetroute": {
      "Type": "AWS::EC2::Route",
      "Properties": {
        "RouteTableId": {
          "Ref": "stagingFruitVendorpubrt"
        },
        "DestinationCidrBlock": "0.0.0.0/0",
        "GatewayId": {
          "Ref": "stagingFruitVendorinternetgw"
        }
      }
    },
    "dockerroute": {
      "Type": "AWS::EC2::Route",
      "Properties": {
        "RouteTableId": {
          "Ref": "stagingFruitVendordockerrt"
        },
        "DestinationCidrBlock": "0.0.0.0/0",
        "GatewayId": {
          "Ref": "stagingFruitVendorinternetgw"
        }
      }
    },
    "localnatroute": {
      "Type": "AWS::EC2::Route",
      "Properties": {
        "RouteTableId": {
          "Ref": "stagingFruitVendorlocalrt"
        },
        "DestinationCidrBlock": "0.0.0.0/0",
        "NatGatewayId": {
          "Ref": "FruitVendorNAT"
        }
      }
    },
    "FruitVendorNATEIP": {
      "Type": "AWS::EC2::EIP",
      "Properties": {
        "Tags": [
          {
            "Key": "Name",
            "Value": "FruitVendor-NAT-EIP"
          }
        ]
      }
    },
    "FruitVendorNWEIP": {
      "Type": "AWS::EC2::EIP",
      "Properties": {
        "Tags": [
          {
            "Key": "Name",
            "Value": "FruitVendor-NW-EIP"
          }
        ]
      }
    },
    "FruitVendorEIPAss": {
      "Type": "AWS::EC2::EIPAssociation",
      "Properties": {
        "AllocationId": {
          "Fn::GetAtt": [
            "FruitVendorNWEIP",
            "AllocationId"
          ]
        },
        "NetworkInterfaceId": {
          "Ref": "FruitVendorNI"
        }
      }
    },
    "stagingFruitVendorinternetgw": {
      "Type": "AWS::EC2::InternetGateway",
      "Properties": {
        "Tags": [
          {
            "Key": "Name",
            "Value": "staging-FruitVendor-internet-gw"
          }
        ]
      }
    },
    "FruitVendorNAT": {
      "Type": "AWS::EC2::NatGateway",
      "Properties": {
        "AllocationId": {
          "Fn::GetAtt": [
            "FruitVendorNATEIP",
            "AllocationId"
          ]
        },
        "SubnetId": {
          "Ref": "DockerSubnetAZA"
        },
        "Tags": [
          {
            "Key": "Name",
            "Value": "FruitVendor-NAT"
          }
        ]
      }
    },
    "stagingFruitVendornetworkacl": {
      "Type": "AWS::EC2::NetworkAcl",
      "Properties": {
        "VpcId": {
          "Ref": "FruitVendorInfrastructure"
        },
        "Tags": [
          {
            "Key": "Name",
            "Value": "staging-FruitVendor-network-acl"
          }
        ]
      }
    },
    "stagingFruitVendornetworkaclinet": {
      "Type": "AWS::EC2::NetworkAclEntry",
      "Properties": {
        "NetworkAclId": {
          "Ref": "stagingFruitVendornetworkacl"
        },
        "RuleAction": "allow",
        "CidrBlock": "0.0.0.0/0",
        "Egress": true,
        "RuleNumber": 100,
        "Protocol": -1
      }
    },
    "stagingFruitVendornetworkaclet": {
      "Type": "AWS::EC2::NetworkAclEntry",
      "Properties": {
        "NetworkAclId": {
          "Ref": "stagingFruitVendornetworkacl"
        },
        "RuleAction": "allow",
        "CidrBlock": "0.0.0.0/0",
