    "PumaLBToDockerSGIn": {
      "Type": "AWS::EC2::SecurityGroupIngress",
      "Properties": {
        "Description": "For Puma - Lets PumaLBSecurityGroup Talk to DockerSecurityGroup",
        "FromPort": 3000,
        "ToPort": 3000,
        "IpProtocol": "tcp",
        "SourceSecurityGroupId": {
          "Ref": "DockerSecurityGroup"
        },
        "GroupId": {
          "Ref": "PumaLBSecurityGroup"
        }
      }
    },
    "DockerToPumaLBSGIn": {
      "Type": "AWS::EC2::SecurityGroupIngress",
      "Properties": {
        "Description": "For Puma - Lets PumaLBSecurityGroup Talk to DockerSecurityGroup",
        "FromPort": 3000,
        "ToPort": 3000,
        "IpProtocol": "tcp",
        "SourceSecurityGroupId": {
          "Ref": "PumaLBSecurityGroup"
        },
        "GroupId": {
          "Ref": "DockerSecurityGroup"
        }
      }
    },
    "DockerToRDSSGIn": {
      "Type": "AWS::EC2::SecurityGroupIngress",
      "Properties": {
        "Description": "For PostgreSQL - Lets DockerSecurityGroup Talk to RDSSecurityGroup",
        "FromPort": 5432,
        "ToPort": 5432,
        "IpProtocol": "tcp",
        "SourceSecurityGroupId": {
          "Ref": "RDSSecurityGroup"
        },
        "GroupId": {
          "Ref": "DockerSecurityGroup"
        }
      }
    },
    "RDSToDockerSGIn": {
