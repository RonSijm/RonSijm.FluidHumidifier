  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "CloudFormation Stack For ECS Services For dev Environment",
  "Resources": {
    "FruitVendorPuma": {
      "Type": "AWS::ECS::Service",
      "Properties": {
        "PlatformVersion": "1.4.0",
        "Cluster": {
          "Ref": "FruitVendordevCluster"
        },
        "DesiredCount": 1,
        "DeploymentController": {
          "Type": "ECS"
        },
        "CapacityProviderStrategy": [
          {
            "CapacityProvider": "FARGATE",
            "Weight": 1
          }
        ],
        "SchedulingStrategy": "REPLICA",
        "TaskDefinition": {
          "Ref": "PumadevTaskDefinition"
        },
        "ServiceName": "FruitVendor-Puma",
        "NetworkConfiguration": {
          "AwsvpcConfiguration": {
            "SecurityGroups": [
              {
                "Fn::ImportValue": "DockerSecurityGroup"
              }
            ],
            "Subnets": [
              {
                "Fn::ImportValue": "DockerSubnetAZA"
              },
              {
                "Fn::ImportValue": "DockerSubnetAZB"
              },
              {
                "Fn::ImportValue": "DockerSubnetAZC"
              }
            ],
            "AssignPublicIp": "ENABLED"
          }
        },
        "Tags": [
          {
            "Key": "Name",
            "Value": "FruitVendor-Puma"
          }
        ],
        "DeploymentConfiguration": {
          "DeploymentCircuitBreaker": {
            "Enable": false,
            "Rollback": false
          },
          "MaximumPercent": 200,
          "MinimumHealthyPercent": 100
        }
      }
    },
