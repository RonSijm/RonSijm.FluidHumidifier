    "PumadevTaskDefinition": {
      "Type": "AWS::ECS::TaskDefinition",
      "Properties": {
        "TaskRoleArn": {
          "Fn::ImportValue": "ECRdevtoassetsAccessRole"
        },
        "Memory": "512",
        "Cpu": "256",
        "RequiresCompatibilities": [
          "FARGATE"
        ],
        "NetworkMode": "awsvpc",
        "ExecutionRoleArn": {
          "Fn::ImportValue": "ECRdevtoassetsAccessRole"
        },
        "RuntimePlatform": {
          "OperatingSystemFamily": "LINUX",
          "CpuArchitecture": "X86_64"
        },
        "Volumes": [
          {
            "Name": "log"
          }
        ],
        "ContainerDefinitions": [
          {
            "Image": "111111111111.dkr.ecr.eu-central-1.amazonaws.com/fruitvendor-assets-ecr-registry:latest",
            "Essential": true,
            "LogConfiguration": {
              "Options": {
                "awslogs-group": "/ecs/Puma",
                "awslogs-create-group": "true",
                "awslogs-region": "eu-central-1",
                "awslogs-stream-prefix": "ecs"
              },
              "LogDriver": "awslogs"
            },
            "EnvironmentFiles": [
              {
                "Type": "s3",
                "Value": "arn:aws:s3:::fruitvendor-dev-webapp-environmentvariables/fruitvendor-webapp.env"
              }
            ],
            "Name": "Puma-ContainerDefinition",
            "MountPoints": [
              {
                "ReadOnly": false,
                "SourceVolume": "log",
                "ContainerPath": "/webapp/log"
              }
            ],
            "PortMappings": [
              {
                "AppProtocol": "http",
                "HostPort": "3000",
                "ContainerPort": "3000",
                "Protocol": "tcp"
              }
            ]
          }
        ],
        "Family": "Puma",
        "Tags": [
          {
            "Key": "Name",
            "Value": "Puma-dev-TaskDefinition"
          }
        ]
      }
    },
