    "AppleStoredevpuma": {
      "Type": "AWS::ECS::Service",
      "Properties": {
        "PlatformVersion": "1.4.0",
        "CapacityProviderStrategy": [
          {
            "CapacityProvider": "FARGATE",
            "Weight": 1
          }
        ],
        "SchedulingStrategy": "REPLICA",
        "NetworkConfiguration": {
          "AwsvpcConfiguration": {
            "SecurityGroups": [
              null
            ],
            "Subnets": "DSB",
            "AssignPublicIp": "ENABLED"
          }
        },
        "EnableExecuteCommand": true,
        "Cluster": {
          "Ref": "AppleStoredevCluster"
        },
        "LoadBalancers": [
          {
            "TargetGroupArn": "LB",
            "ContainerName": "dev-puma-ContainerDefinition",
            "ContainerPort": 3000
          }
        ],
        "DesiredCount": 3,
        "DeploymentController": {
          "Type": "ECS"
        },
        "TaskDefinition": {
          "Ref": "devpuma"
        },
        "ServiceName": "AppleStore-dev-puma",
        "DeploymentConfiguration": {
          "DeploymentCircuitBreaker": {
            "Enable": false,
            "Rollback": false
          },
          "MaximumPercent": 200,
          "MinimumHealthyPercent": 100
        }
      },
      "CreationPolicy": {
        "ResourceSignal": {
          "Count": 0,
          "Timeout": "PT1S"
        }
      }
    },
