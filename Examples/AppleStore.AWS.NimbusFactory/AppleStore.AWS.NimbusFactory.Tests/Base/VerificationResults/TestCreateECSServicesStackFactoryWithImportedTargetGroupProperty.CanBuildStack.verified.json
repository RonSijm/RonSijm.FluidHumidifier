{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Resources": {
    "AppleStoredevCluster": {
      "Type": "AWS::ECS::Cluster",
      "Properties": {
        "CapacityProviders": [
          "FARGATE",
          "FARGATE_SPOT"
        ],
        "ClusterName": "AppleStore-dev-Cluster"
      }
    },
    "devpuma": {
      "Type": "AWS::ECS::TaskDefinition",
      "Properties": {
        "TaskRoleArn": {
          "Ref": "RF"
        },
        "Memory": "8192",
        "Cpu": "2048",
        "RequiresCompatibilities": [
          "FARGATE"
        ],
        "NetworkMode": "awsvpc",
        "ExecutionRoleArn": {
          "Ref": "RF"
        },
        "RuntimePlatform": {
          "OperatingSystemFamily": "LINUX",
          "CpuArchitecture": "X86_64"
        },
        "Volumes": [
          {
            "Name": "log"
          }
        ],
        "ContainerDefinitions": [
          {
            "HealthCheck": {
              "Command": [
                "CMD-SHELL",
                "exit 0"
              ],
              "Timeout": 30,
              "Retries": 3,
              "Interval": 30,
              "StartPeriod": 1
            },
            "Image": "111111111111.dkr.ecr.eu-central-1.amazonaws.com/applestore-webapp:latest-dev",
            "Essential": true,
            "LogConfiguration": {
              "Options": {
                "awslogs-group": "/ecs/dev-puma",
                "awslogs-create-group": "true",
                "awslogs-region": "eu-central-1",
                "awslogs-stream-prefix": "ecs"
              },
              "LogDriver": "awslogs"
            },
            "EnvironmentFiles": [
              {
                "Type": "s3",
                "Value": "arn:aws:s3:::applestore-dev-webapp-environmentvariables/applestore-webapp.env"
              }
            ],
            "Name": "dev-puma-ContainerDefinition",
            "MountPoints": [
              {
                "ReadOnly": false,
                "SourceVolume": "log",
                "ContainerPath": "/webapp/log"
              }
            ],
            "PortMappings": [
              {
                "AppProtocol": "http",
                "HostPort": "3000",
                "ContainerPort": "3000",
                "Protocol": "tcp"
              }
            ]
          }
        ],
        "Family": "dev-puma"
      }
    },
    "devsidekiq": {
      "Type": "AWS::ECS::TaskDefinition",
      "Properties": {
        "TaskRoleArn": {
          "Ref": "RF"
        },
        "Memory": "8192",
        "Cpu": "1024",
        "RequiresCompatibilities": [
          "FARGATE"
        ],
        "NetworkMode": "awsvpc",
        "ExecutionRoleArn": {
          "Ref": "RF"
        },
        "RuntimePlatform": {
          "OperatingSystemFamily": "LINUX",
          "CpuArchitecture": "X86_64"
        },
        "Volumes": [
          {
            "Name": "log"
          }
        ],
        "ContainerDefinitions": [
          {
            "HealthCheck": {
              "Command": [
                "CMD-SHELL",
                "exit 0"
              ],
              "Timeout": 30,
              "Retries": 3,
              "Interval": 30,
              "StartPeriod": 1
            },
            "EntryPoint": [
              "/rails/bin/docker-entrypoint"
            ],
            "Image": "111111111111.dkr.ecr.eu-central-1.amazonaws.com/applestore-webapp:latest-dev",
            "Essential": true,
            "LogConfiguration": {
              "Options": {
                "awslogs-group": "/ecs/dev-sidekiq",
                "awslogs-create-group": "true",
                "awslogs-region": "eu-central-1",
                "awslogs-stream-prefix": "ecs"
              },
              "LogDriver": "awslogs"
            },
            "EnvironmentFiles": [
              {
                "Type": "s3",
                "Value": "arn:aws:s3:::applestore-dev-webapp-environmentvariables/applestore-webapp.env"
