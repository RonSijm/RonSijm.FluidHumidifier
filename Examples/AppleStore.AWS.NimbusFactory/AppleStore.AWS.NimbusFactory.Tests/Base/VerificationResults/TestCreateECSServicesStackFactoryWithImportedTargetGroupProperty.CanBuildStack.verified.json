            ],
            "Name": "dev-sidekiq-ContainerDefinition",
            "MountPoints": [
              {
                "ReadOnly": false,
                "SourceVolume": "log",
                "ContainerPath": "/webapp/log"
              }
            ],
            "Command": [
              "/usr/local/bin/bundle",
              "exec",
              "sidekiq",
              "-C",
              "/rails/config/sidekiq.yml"
            ]
          },
          {
            "HealthCheck": {
              "Command": [
                "CMD-SHELL",
                "exit 0"
              ],
              "Timeout": 30,
              "Retries": 3,
              "Interval": 30,
              "StartPeriod": 1
            },
            "EntryPoint": [
              "/rails/bin/docker-entrypoint"
            ],
            "Image": "111111111111.dkr.ecr.eu-central-1.amazonaws.com/applestore-webapp:latest-dev",
            "Essential": true,
            "LogConfiguration": {
              "Options": {
                "awslogs-group": "/ecs/dev-sidekiq",
                "awslogs-create-group": "true",
                "awslogs-region": "eu-central-1",
                "awslogs-stream-prefix": "ecs"
              },
              "LogDriver": "awslogs"
            },
            "EnvironmentFiles": [
              {
                "Type": "s3",
                "Value": "arn:aws:s3:::applestore-dev-webapp-environmentvariables/applestore-webapp.env"
              }
            ],
            "Name": "dev-sidekiq-export-ContainerDefinition",
            "MountPoints": [
              {
                "ReadOnly": false,
                "SourceVolume": "log",
                "ContainerPath": "/webapp/log"
              }
            ],
            "Command": [
              "/usr/local/bin/bundle",
              "exec",
              "sidekiq",
              "-C",
              "/rails/config/sidekiq-content-export.yml"
            ]
          },
          {
            "HealthCheck": {
              "Command": [
                "CMD-SHELL",
                "exit 0"
              ],
              "Timeout": 30,
              "Retries": 3,
              "Interval": 30,
              "StartPeriod": 1
            },
            "EntryPoint": [
              "/rails/bin/docker-entrypoint"
            ],
            "Image": "111111111111.dkr.ecr.eu-central-1.amazonaws.com/applestore-webapp:latest-dev",
            "Essential": true,
            "LogConfiguration": {
              "Options": {
                "awslogs-group": "/ecs/dev-sidekiq",
                "awslogs-create-group": "true",
                "awslogs-region": "eu-central-1",
                "awslogs-stream-prefix": "ecs"
              },
              "LogDriver": "awslogs"
            },
            "EnvironmentFiles": [
              {
                "Type": "s3",
                "Value": "arn:aws:s3:::applestore-dev-webapp-environmentvariables/applestore-webapp.env"
              }
            ],
            "Name": "dev-sidekiq-duplication-high-priority-ContainerDefinition",
            "MountPoints": [
              {
                "ReadOnly": false,
                "SourceVolume": "log",
                "ContainerPath": "/webapp/log"
              }
            ],
            "Command": [
              "/usr/local/bin/bundle",
              "exec",
              "sidekiq",
              "-C",
              "/rails/config/sidekiq-duplication-high-priority.yml"
            ]
          },
          {
            "HealthCheck": {
              "Command": [
                "CMD-SHELL",
                "exit 0"
              ],
              "Timeout": 30,
              "Retries": 3,
              "Interval": 30,
              "StartPeriod": 1
            },
            "EntryPoint": [
              "/rails/bin/docker-entrypoint"
            ],
            "Image": "111111111111.dkr.ecr.eu-central-1.amazonaws.com/applestore-webapp:latest-dev",
            "Essential": true,
            "LogConfiguration": {
              "Options": {
                "awslogs-group": "/ecs/dev-sidekiq",
                "awslogs-create-group": "true",
                "awslogs-region": "eu-central-1",
                "awslogs-stream-prefix": "ecs"
              },
              "LogDriver": "awslogs"
            },
            "EnvironmentFiles": [
              {
                "Type": "s3",
                "Value": "arn:aws:s3:::applestore-dev-webapp-environmentvariables/applestore-webapp.env"
              }
            ],
            "Name": "dev-sidekiq-duplication-low-priority-ContainerDefinition",
            "MountPoints": [
              {
                "ReadOnly": false,
                "SourceVolume": "log",
                "ContainerPath": "/webapp/log"
              }
            ],
            "Command": [
              "/usr/local/bin/bundle",
              "exec",
              "sidekiq",
              "-C",
              "/rails/config/sidekiq-duplication-low-priority.yml"
            ]
          }
        ],
        "Family": "dev-sidekiq",
        "EphemeralStorage": {
          "SizeInGiB": "40"
        }
      }
    },
