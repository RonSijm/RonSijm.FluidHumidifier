            "Name": "dev-rpush-rpush-ContainerDefinition",
            "MountPoints": [
              {
                "ReadOnly": false,
                "SourceVolume": "log",
                "ContainerPath": "/webapp/log"
              }
            ],
            "Command": [
              "/usr/local/bin/bundle",
              "exec",
              "rpush",
              "start",
              "-f"
            ]
          }
        ],
        "Family": "dev-rpush"
      }
    },
    "devjobs": {
      "Type": "AWS::ECS::TaskDefinition",
      "Properties": {
        "TaskRoleArn": {
          "Ref": "RF"
        },
        "Memory": "512",
        "Cpu": "256",
        "RequiresCompatibilities": [
          "FARGATE"
        ],
        "NetworkMode": "awsvpc",
        "ExecutionRoleArn": {
          "Ref": "RF"
        },
        "RuntimePlatform": {
          "OperatingSystemFamily": "LINUX",
          "CpuArchitecture": "X86_64"
        },
        "Volumes": [
          {
            "Name": "log"
          }
        ],
        "ContainerDefinitions": [
          {
            "EntryPoint": [
              "/usr/local/bin/docker-entrypoint.sh"
            ],
            "Image": ".dkr.ecr.eu-central-1.amazonaws.com/applestore-assets-ecr-registry:latest",
            "Essential": true,
            "LogConfiguration": {
              "Options": {
                "awslogs-group": "/ecs/dev-jobs",
                "awslogs-create-group": "true",
                "awslogs-region": "eu-central-1",
                "awslogs-stream-prefix": "ecs"
              },
              "LogDriver": "awslogs"
            },
            "EnvironmentFiles": [
              {
                "Type": "s3",
                "Value": "arn:aws:s3:::applestore-dev-webapp-environmentvariables/applestore-webapp.env"
              }
            ],
            "Name": "dev-jobs-jobs1-ContainerDefinition",
            "MountPoints": [
              {
                "ReadOnly": false,
                "SourceVolume": "log",
                "ContainerPath": "/webapp/log"
              }
            ],
            "Command": [
              "cron",
              "-f"
            ],
            "Environment": [
              {
                "Value": "jobs_1",
                "Name": "SERVER_ROLE"
              }
            ]
          },
          {
            "EntryPoint": [
              "/usr/local/bin/docker-entrypoint.sh"
            ],
            "Image": ".dkr.ecr.eu-central-1.amazonaws.com/applestore-assets-ecr-registry:latest",
            "Essential": true,
            "LogConfiguration": {
              "Options": {
                "awslogs-group": "/ecs/dev-jobs",
                "awslogs-create-group": "true",
                "awslogs-region": "eu-central-1",
                "awslogs-stream-prefix": "ecs"
              },
              "LogDriver": "awslogs"
            },
            "EnvironmentFiles": [
              {
                "Type": "s3",
                "Value": "arn:aws:s3:::applestore-dev-webapp-environmentvariables/applestore-webapp.env"
              }
            ],
            "Name": "dev-jobs-jobs2-ContainerDefinition",
            "MountPoints": [
              {
                "ReadOnly": false,
                "SourceVolume": "log",
                "ContainerPath": "/webapp/log"
              }
            ],
            "Command": [
              "cron",
              "-f"
            ],
            "Environment": [
              {
                "Value": "jobs_2",
                "Name": "SERVER_ROLE"
              }
            ]
          }
        ],
        "Family": "dev-jobs"
      }
    },
    "ecsPuma": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": "/ecs/Puma"
      }
    },
    "ecsdevsidekiq": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": "/ecs/dev-sidekiq"
      }
    },
    "ecsdevrpush": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": "/ecs/dev-rpush"
      }
    },
    "ecsdevjobs": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": "/ecs/dev-jobs"
      }
    }
  }
}