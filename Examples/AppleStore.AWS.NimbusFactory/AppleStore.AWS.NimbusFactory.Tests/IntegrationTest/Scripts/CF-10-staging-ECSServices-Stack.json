{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "CloudFormation Stack For ECS Services For staging Environment",
  "Resources": {
    "AppleStorestagingpuma": {
      "Type": "AWS::ECS::Service",
      "Properties": {
        "PlatformVersion": "1.4.0",
        "EnableExecuteCommand": true,
        "Cluster": {
          "Ref": "AppleStorestagingCluster"
        },
        "LoadBalancers": [
          {
            "TargetGroupArn": {
              "Fn::ImportValue": "AppleStorePumaLBstagingLBTG"
            },
            "ContainerName": "staging-puma-ContainerDefinition",
            "ContainerPort": 3000
          }
        ],
        "DesiredCount": 1,
        "DeploymentController": {
          "Type": "ECS"
        },
        "CapacityProviderStrategy": [
          {
            "CapacityProvider": "FARGATE",
            "Weight": 1
          }
        ],
        "SchedulingStrategy": "REPLICA",
        "TaskDefinition": {
          "Ref": "stagingpumastagingTaskDefinition"
        },
        "ServiceName": "AppleStore-staging-puma",
        "NetworkConfiguration": {
          "AwsvpcConfiguration": {
            "SecurityGroups": [
              {
                "Fn::ImportValue": "DockerSecurityGroup"
              }
            ],
            "Subnets": [
              {
                "Fn::ImportValue": "DockerSubnetAZA"
              },
              {
                "Fn::ImportValue": "DockerSubnetAZB"
              },
              {
                "Fn::ImportValue": "DockerSubnetAZC"
              }
            ],
            "AssignPublicIp": "ENABLED"
          }
        },
        "Tags": [
          {
            "Key": "Name",
            "Value": "AppleStore-staging-puma"
          }
        ],
        "DeploymentConfiguration": {
          "DeploymentCircuitBreaker": {
            "Enable": false,
            "Rollback": false
          },
          "MaximumPercent": 200,
          "MinimumHealthyPercent": 100
        }
      }
    },
