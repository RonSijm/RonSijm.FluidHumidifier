    "stagingpumastagingTaskDefinition": {
      "Type": "AWS::ECS::TaskDefinition",
      "Properties": {
        "TaskRoleArn": {
          "Fn::ImportValue": "ECRstagingtoassetsAccessRole"
        },
        "Memory": "3072",
        "Cpu": "1024",
        "RequiresCompatibilities": [
          "FARGATE"
        ],
        "NetworkMode": "awsvpc",
        "ExecutionRoleArn": {
          "Fn::ImportValue": "ECRstagingtoassetsAccessRole"
        },
        "RuntimePlatform": {
          "OperatingSystemFamily": "LINUX",
          "CpuArchitecture": "X86_64"
        },
        "Volumes": [
          {
            "Name": "log"
          }
        ],
        "ContainerDefinitions": [
          {
            "HealthCheck": {
              "Command": [
                "CMD-SHELL",
                "exit 0"
              ],
              "Timeout": 30,
              "Retries": 3,
              "Interval": 30,
              "StartPeriod": 1
            },
            "Image": "111111111111.dkr.ecr.eu-central-1.amazonaws.com/applestore-assets-ecr-registry:latest-staging",
            "Essential": true,
            "LogConfiguration": {
              "Options": {
                "awslogs-group": "/ecs/staging-puma",
                "awslogs-create-group": "true",
                "awslogs-region": "eu-central-1",
                "awslogs-stream-prefix": "ecs"
              },
              "LogDriver": "awslogs"
            },
            "EnvironmentFiles": [
              {
                "Type": "s3",
                "Value": "arn:aws:s3:::applestore-staging-webapp-environmentvariables/applestore-webapp.env"
              }
            ],
            "Name": "staging-puma-ContainerDefinition",
            "MountPoints": [
              {
                "ReadOnly": false,
                "SourceVolume": "log",
                "ContainerPath": "/webapp/log"
              }
            ],
            "PortMappings": [
              {
                "AppProtocol": "http",
                "HostPort": "3000",
                "ContainerPort": "3000",
                "Protocol": "tcp"
              }
            ]
          }
        ],
        "Family": "staging-puma",
        "Tags": [
          {
            "Key": "Name",
            "Value": "staging-puma-staging-TaskDefinition"
          }
        ]
      }
    },
