{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "CloudFormation Stack For VPC Infrastructure For dev Environment",
  "Resources": {
    "internetroute": {
      "Type": "AWS::EC2::Route",
      "Properties": {
        "RouteTableId": {
          "Ref": "devAppleStorepubrt"
        },
        "DestinationCidrBlock": "0.0.0.0/0",
        "GatewayId": {
          "Ref": "devAppleStoreinternetgw"
        }
      }
    },
    "dockerroute": {
      "Type": "AWS::EC2::Route",
      "Properties": {
        "RouteTableId": {
          "Ref": "devAppleStoredockerrt"
        },
        "DestinationCidrBlock": "0.0.0.0/0",
        "GatewayId": {
          "Ref": "devAppleStoreinternetgw"
        }
      }
    },
    "localnatroute": {
      "Type": "AWS::EC2::Route",
      "Properties": {
        "RouteTableId": {
          "Ref": "devAppleStorelocalrt"
        },
        "DestinationCidrBlock": "0.0.0.0/0",
        "NatGatewayId": {
          "Ref": "AppleStoreNAT"
        }
      }
    },
    "AppleStoreNATEIP": {
      "Type": "AWS::EC2::EIP",
      "Properties": {
        "Tags": [
          {
            "Key": "Name",
            "Value": "AppleStore-NAT-EIP"
          }
        ]
      }
    },
    "AppleStoreNWEIP": {
      "Type": "AWS::EC2::EIP",
      "Properties": {
        "Tags": [
          {
            "Key": "Name",
            "Value": "AppleStore-NW-EIP"
          }
        ]
      }
    },
    "AppleStoreEIPAss": {
      "Type": "AWS::EC2::EIPAssociation",
      "Properties": {
        "AllocationId": {
          "Fn::GetAtt": [
            "AppleStoreNWEIP",
            "AllocationId"
          ]
        },
        "NetworkInterfaceId": {
          "Ref": "AppleStoreNI"
        }
      }
    },
    "devAppleStoreinternetgw": {
      "Type": "AWS::EC2::InternetGateway",
      "Properties": {
        "Tags": [
          {
            "Key": "Name",
            "Value": "dev-AppleStore-internet-gw"
          }
        ]
      }
    },
    "AppleStoreNAT": {
      "Type": "AWS::EC2::NatGateway",
      "Properties": {
        "AllocationId": {
          "Fn::GetAtt": [
            "AppleStoreNATEIP",
            "AllocationId"
          ]
        },
        "SubnetId": {
          "Ref": "DockerSubnetAZA"
        },
        "Tags": [
          {
            "Key": "Name",
            "Value": "AppleStore-NAT"
          }
        ]
      }
    },
    "devAppleStorenetworkacl": {
      "Type": "AWS::EC2::NetworkAcl",
      "Properties": {
        "VpcId": {
          "Ref": "AppleStoreInfrastructure"
        },
        "Tags": [
          {
            "Key": "Name",
            "Value": "dev-AppleStore-network-acl"
          }
        ]
      }
    },
    "devAppleStorenetworkaclinet": {
      "Type": "AWS::EC2::NetworkAclEntry",
      "Properties": {
        "NetworkAclId": {
          "Ref": "devAppleStorenetworkacl"
        },
        "RuleAction": "allow",
        "CidrBlock": "0.0.0.0/0",
        "Egress": true,
        "RuleNumber": 100,
        "Protocol": -1
      }
    },
    "devAppleStorenetworkaclet": {
      "Type": "AWS::EC2::NetworkAclEntry",
      "Properties": {
        "NetworkAclId": {
          "Ref": "devAppleStorenetworkacl"
        },
        "RuleAction": "allow",
        "CidrBlock": "0.0.0.0/0",
        "RuleNumber": 100,
        "Protocol": -1
      }
    },
    "AppleStoreNI": {
      "Type": "AWS::EC2::NetworkInterface",
      "Properties": {
        "SubnetId": {
          "Ref": "DockerSubnetAZA"
        },
        "Tags": [
          {
            "Key": "Name",
            "Value": "AppleStore-NI"
          }
        ]
      }
    },
    "devAppleStorepubrt": {
      "Type": "AWS::EC2::RouteTable",
      "Properties": {
        "VpcId": {
          "Ref": "AppleStoreInfrastructure"
        },
        "Tags": [
          {
            "Key": "Name",
            "Value": "dev-AppleStore-pub-rt"
          }
        ]
      }
    },
    "devAppleStorelocalrt": {
      "Type": "AWS::EC2::RouteTable",
      "Properties": {
        "VpcId": {
          "Ref": "AppleStoreInfrastructure"
        },
        "Tags": [
          {
            "Key": "Name",
            "Value": "dev-AppleStore-local-rt"
          }
        ]
      }
    },
    "devAppleStoredockerrt": {
      "Type": "AWS::EC2::RouteTable",
      "Properties": {
        "VpcId": {
          "Ref": "AppleStoreInfrastructure"
        },
        "Tags": [
          {
            "Key": "Name",
            "Value": "dev-AppleStore-docker-rt"
          }
        ]
      }
    },
    "PumaLBToDockerSGIn": {
      "Type": "AWS::EC2::SecurityGroupIngress",
      "Properties": {
        "Description": "For Puma - Lets PumaLBSecurityGroup Talk to DockerSecurityGroup",
        "FromPort": 3000,
        "ToPort": 3000,
        "IpProtocol": "tcp",
        "SourceSecurityGroupId": {
          "Ref": "DockerSecurityGroup"
        },
        "GroupId": {
          "Ref": "PumaLBSecurityGroup"
        }
      }
    },
    "DockerToPumaLBSGIn": {
      "Type": "AWS::EC2::SecurityGroupIngress",
      "Properties": {
        "Description": "For Puma - Lets PumaLBSecurityGroup Talk to DockerSecurityGroup",
        "FromPort": 3000,
        "ToPort": 3000,
        "IpProtocol": "tcp",
        "SourceSecurityGroupId": {
          "Ref": "PumaLBSecurityGroup"
        },
        "GroupId": {
          "Ref": "DockerSecurityGroup"
        }
      }
    },
    "DockerToRDSSGIn": {
      "Type": "AWS::EC2::SecurityGroupIngress",
      "Properties": {
        "Description": "For PostgreSQL - Lets DockerSecurityGroup Talk to RDSSecurityGroup",
        "FromPort": 5432,
        "ToPort": 5432,
        "IpProtocol": "tcp",
        "SourceSecurityGroupId": {
          "Ref": "RDSSecurityGroup"
        },
        "GroupId": {
          "Ref": "DockerSecurityGroup"
        }
      }
    },
    "RDSToDockerSGIn": {
      "Type": "AWS::EC2::SecurityGroupIngress",
      "Properties": {
        "Description": "For PostgreSQL - Lets DockerSecurityGroup Talk to RDSSecurityGroup",
        "FromPort": 5432,
        "ToPort": 5432,
        "IpProtocol": "tcp",
        "SourceSecurityGroupId": {
          "Ref": "DockerSecurityGroup"
        },
        "GroupId": {
          "Ref": "RDSSecurityGroup"
        }
      }
    },
    "DockerToRedisSGIn": {
      "Type": "AWS::EC2::SecurityGroupIngress",
      "Properties": {
        "Description": "For Redis - Lets DockerSecurityGroup Talk to RedisSecurityGroup",
        "FromPort": 6379,
        "ToPort": 6379,
        "IpProtocol": "tcp",
        "SourceSecurityGroupId": {
          "Ref": "RedisSecurityGroup"
        },
        "GroupId": {
          "Ref": "DockerSecurityGroup"
        }
      }
    },
    "RedisToDockerSGIn": {
      "Type": "AWS::EC2::SecurityGroupIngress",
      "Properties": {
        "Description": "For Redis - Lets DockerSecurityGroup Talk to RedisSecurityGroup",
        "FromPort": 6379,
        "ToPort": 6379,
        "IpProtocol": "tcp",
        "SourceSecurityGroupId": {
          "Ref": "DockerSecurityGroup"
        },
        "GroupId": {
          "Ref": "RedisSecurityGroup"
        }
      }
    },
    "RDSSubnetGroup": {
      "Type": "AWS::RDS::DBSubnetGroup",
      "Properties": {
        "DBSubnetGroupName": "RDS Subnet Group",
        "DBSubnetGroupDescription": "VPC Infrastructure-dev-RDS Subnet Group Subnet Group",
        "SubnetIds": [
          {
            "Ref": "RDSSubnetAZA"
          },
          {
            "Ref": "RDSSubnetAZB"
          },
          {
            "Ref": "RDSSubnetAZC"
          }
        ],
        "Tags": [
          {
            "Key": "Name",
            "Value": "RDS Subnet Group"
          }
        ]
      },
      "DependsOn": [
        "RDSSubnetAZA",
        "RDSSubnetAZB",
        "RDSSubnetAZC"
      ]
    },
    "RedisSubnetGroup": {
      "Type": "AWS::ElastiCache::SubnetGroup",
      "Properties": {
        "Description": "Default Subnet Group for ElastiCache",
        "SubnetIds": [
          {
            "Ref": "RedisSubnetAZA"
          },
          {
            "Ref": "RedisSubnetAZB"
          },
          {
            "Ref": "RedisSubnetAZC"
          }
        ],
        "Tags": [
          {
            "Key": "Name",
            "Value": "Redis Subnet Group"
          }
        ]
      },
      "DependsOn": [
        "RedisSubnetAZA",
        "RedisSubnetAZB",
        "RedisSubnetAZC"
      ]
    },
    "RedisSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "Default dev Security Group for Redis",
        "VpcId": {
          "Ref": "AppleStoreInfrastructure"
        },
        "Tags": [
          {
            "Key": "Name",
            "Value": "Redis-SecurityGroup"
          }
        ]
      },
      "DependsOn": [
        "AppleStoreInfrastructure"
      ]
    },
    "PumaLBSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "Default dev Security Group for Puma-LB",
        "VpcId": {
          "Ref": "AppleStoreInfrastructure"
        },
        "SecurityGroupIngress": [
          {
            "CidrIp": "0.0.0.0/0",
            "Description": "For Http Inbound - Lets PumaLBSecurityGroup Communicate over tcp 80-80",
            "FromPort": 80,
            "ToPort": 80,
            "IpProtocol": "tcp"
          },
          {
            "CidrIp": "0.0.0.0/0",
            "Description": "For Https Inbound - Lets PumaLBSecurityGroup Communicate over tcp 443-443",
            "FromPort": 443,
            "ToPort": 443,
            "IpProtocol": "tcp"
          }
        ],
        "Tags": [
          {
            "Key": "Name",
            "Value": "Puma-LB-SecurityGroup"
          }
        ]
      },
      "DependsOn": [
        "AppleStoreInfrastructure"
      ]
    },
    "DockerSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
