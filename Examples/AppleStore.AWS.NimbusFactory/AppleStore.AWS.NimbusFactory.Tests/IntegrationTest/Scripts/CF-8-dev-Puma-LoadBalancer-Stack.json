{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "CloudFormation Stack For Puma-LoadBalancer For dev Environment",
  "Resources": {
    "AppleStore": {
      "Type": "AWS::ElasticLoadBalancingV2::LoadBalancer",
      "Properties": {
        "IpAddressType": "ipv4",
        "SecurityGroups": [
          {
            "Fn::ImportValue": "PumaLoadBalancerSecurityGroup"
          }
        ],
        "LoadBalancerAttributes": [
          {
            "Value": "false",
            "Key": "access_logs.s3.enabled"
          },
          {
            "Value": "60",
            "Key": "idle_timeout.timeout_seconds"
          },
          {
            "Value": "false",
            "Key": "deletion_protection.enabled"
          },
          {
            "Value": "true",
            "Key": "routing.http2.enabled"
          },
          {
            "Value": "false",
            "Key": "routing.http.drop_invalid_header_fields.enabled"
          },
          {
            "Value": "true",
            "Key": "routing.http.xff_client_port.enabled"
          },
          {
            "Value": "true",
            "Key": "routing.http.preserve_host_header.enabled"
          },
          {
            "Value": "append",
            "Key": "routing.http.xff_header_processing.mode"
          },
          {
            "Value": "true",
            "Key": "load_balancing.cross_zone.enabled"
          },
          {
            "Value": "defensive",
            "Key": "routing.http.desync_mitigation_mode"
          },
          {
            "Value": "3600",
            "Key": "client_keep_alive.seconds"
          },
          {
            "Value": "false",
            "Key": "waf.fail_open.enabled"
          },
          {
            "Value": "false",
            "Key": "routing.http.x_amzn_tls_version_and_cipher_suite.enabled"
          },
          {
            "Value": "false",
            "Key": "connection_logs.s3.enabled"
          }
        ],
        "Subnets": [
          {
            "Fn::ImportValue": "Puma-LoadBalancerSubnetAZA"
          },
          {
            "Fn::ImportValue": "Puma-LoadBalancerSubnetAZB"
          },
          {
            "Fn::ImportValue": "Puma-LoadBalancerSubnetAZC"
          }
        ],
        "Type": "application",
        "Scheme": "internet-facing",
        "Tags": [
          {
            "Key": "Name",
            "Value": "AppleStore"
          }
        ],
        "Name": "AppleStore"
      }
    },
    "HTTP": {
      "Type": "AWS::ElasticLoadBalancingV2::Listener",
      "Properties": {
        "LoadBalancerArn": {
          "Fn::Sub": "arn:aws:elasticloadbalancingv2:${AWS::Region}:${AWS::AccountId}:loadbalancer/AppleStore"
        },
        "DefaultActions": [
          {
            "Order": 1,
            "TargetGroupArn": {
              "Ref": "AppleStoreecstg"
            },
            "Type": "forward"
          }
        ],
        "Port": 443,
        "Certificates": [
          {
            "CertificateArn": "arn:aws:acm:us-east-1:333333333333:certificate/00000000-0000-0000-0000-000000000008"
          }
        ],
        "Protocol": "HTTPS"
      }
    },
    "AppleStoreecstg": {
      "Type": "AWS::ElasticLoadBalancingV2::TargetGroup",
      "Properties": {
        "HealthCheckIntervalSeconds": 30,
        "Matcher": {
          "HttpCode": "200"
        },
        "HealthCheckPath": "/",
        "Port": 3000,
        "HealthCheckEnabled": true,
        "UnhealthyThresholdCount": 2,
        "HealthCheckTimeoutSeconds": 5,
        "Name": "AppleStoreecs-tg",
        "VpcId": {
          "Fn::ImportValue": "AppleStoreInfrastructure"
        },
        "HealthyThresholdCount": 5,
        "HealthCheckProtocol": "HTTP",
        "TargetGroupAttributes": [
          {
            "Value": "off",
            "Key": "target_group_health.unhealthy_state_routing.minimum_healthy_targets.percentage"
          },
          {
            "Value": "300",
            "Key": "deregistration_delay.timeout_seconds"
          },
          {
            "Value": "lb_cookie",
            "Key": "stickiness.type"
          },
          {
            "Value": "86400",
            "Key": "stickiness.lb_cookie.duration_seconds"
          },
          {
            "Value": "0",
            "Key": "slow_start.duration_seconds"
          },
          {
            "Value": "86400",
            "Key": "stickiness.app_cookie.duration_seconds"
          },
          {
            "Value": "off",
            "Key": "target_group_health.dns_failover.minimum_healthy_targets.percentage"
          },
          {
            "Value": "use_load_balancer_configuration",
            "Key": "load_balancing.cross_zone.enabled"
          },
          {
            "Value": "round_robin",
            "Key": "load_balancing.algorithm.type"
          },
          {
            "Value": "1",
            "Key": "target_group_health.unhealthy_state_routing.minimum_healthy_targets.count"
          },
          {
            "Value": "false",
            "Key": "stickiness.enabled"
          },
          {
            "Value": "1",
            "Key": "target_group_health.dns_failover.minimum_healthy_targets.count"
          },
          {
            "Value": "off",
            "Key": "load_balancing.algorithm.anomaly_mitigation"
          },
          {
            "Value": "",
            "Key": "stickiness.app_cookie.cookie_name"
          }
        ],
        "TargetType": "ip",
        "HealthCheckPort": "3000",
        "Protocol": "HTTP",
        "Tags": [
          {
            "Key": "Name",
            "Value": "AppleStoreecs-tg"
          }
        ]
      }
    }
  },
  "Outputs": {
    "AppleStoreecstg": {
      "Value": {
        "Ref": "AppleStoreecstg"
      },
      "Export": {
        "Name": {
          "Fn::Sub": "AppleStoreecstg"
        }
      }
    }
  }
}