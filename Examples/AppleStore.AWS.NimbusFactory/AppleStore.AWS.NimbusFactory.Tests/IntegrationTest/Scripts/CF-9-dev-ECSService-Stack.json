{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "CloudFormation Stack For ECSService For dev Environment",
  "Resources": {
    "AppleStoredevPuma": {
      "Type": "AWS::ECS::Service",
      "Properties": {
        "PlatformVersion": "1.4.0",
        "Cluster": {
          "Ref": "AppleStoredevCluster"
        },
        "LoadBalancers": [
          {
            "TargetGroupArn": {
              "Fn::ImportValue": "AppleStoreecstg"
            },
            "ContainerName": "dev-Puma",
            "ContainerPort": 3000
          }
        ],
        "DesiredCount": 1,
        "DeploymentController": {
          "Type": "ECS"
        },
        "CapacityProviderStrategy": [
          {
            "CapacityProvider": "FARGATE",
            "Weight": 1
          }
        ],
        "SchedulingStrategy": "REPLICA",
        "TaskDefinition": {
          "Ref": "devPuma"
        },
        "ServiceName": "AppleStore-dev-Puma",
        "NetworkConfiguration": {
          "AwsvpcConfiguration": {
            "SecurityGroups": [
              {
                "Fn::ImportValue": "DockerSecurityGroup"
              }
            ],
            "Subnets": [
              {
                "Fn::ImportValue": "DockerSubnetAZA"
              },
              {
                "Fn::ImportValue": "DockerSubnetAZB"
              },
              {
                "Fn::ImportValue": "DockerSubnetAZC"
              }
            ],
            "AssignPublicIp": "ENABLED"
          }
        },
        "Tags": [
          {
            "Key": "Name",
            "Value": "AppleStore-dev-Puma"
          }
        ],
        "DeploymentConfiguration": {
          "DeploymentCircuitBreaker": {
            "Enable": false,
            "Rollback": false
          },
          "MaximumPercent": 200,
          "MinimumHealthyPercent": 100
        }
      }
    },
    "AppleStoredevsidekiq": {
      "Type": "AWS::ECS::Service",
      "Properties": {
        "PlatformVersion": "1.4.0",
        "Cluster": {
          "Ref": "AppleStoredevCluster"
        },
        "DesiredCount": 1,
        "DeploymentController": {
          "Type": "ECS"
        },
        "CapacityProviderStrategy": [
          {
            "CapacityProvider": "FARGATE",
            "Weight": 1
          }
        ],
        "SchedulingStrategy": "REPLICA",
        "TaskDefinition": {
          "Ref": "devsidekiq"
        },
        "ServiceName": "AppleStore-dev-sidekiq",
        "NetworkConfiguration": {
          "AwsvpcConfiguration": {
            "SecurityGroups": [
              {
                "Fn::ImportValue": "DockerSecurityGroup"
              }
            ],
            "Subnets": [
              {
                "Fn::ImportValue": "DockerSubnetAZA"
              },
              {
                "Fn::ImportValue": "DockerSubnetAZB"
              },
              {
                "Fn::ImportValue": "DockerSubnetAZC"
              }
            ],
            "AssignPublicIp": "ENABLED"
          }
        },
        "Tags": [
          {
            "Key": "Name",
            "Value": "AppleStore-dev-sidekiq"
          }
        ],
        "DeploymentConfiguration": {
          "DeploymentCircuitBreaker": {
            "Enable": false,
            "Rollback": false
          },
          "MaximumPercent": 200,
          "MinimumHealthyPercent": 100
        }
      }
    },
    "AppleStoredevCluster": {
      "Type": "AWS::ECS::Cluster",
      "Properties": {
        "CapacityProviders": [
          "FARGATE",
          "FARGATE_SPOT"
        ],
        "ClusterName": "AppleStore-dev-Cluster",
        "Tags": [
          {
            "Key": "Name",
            "Value": "AppleStore-dev-Cluster"
          }
        ]
      }
    },
    "devPuma": {
      "Type": "AWS::ECS::TaskDefinition",
      "Properties": {
        "TaskRoleArn": {
          "Fn::ImportValue": "ECRdevtoassetsAccessRole"
        },
        "Memory": "512",
        "Cpu": "256",
        "RequiresCompatibilities": [
          "FARGATE"
        ],
        "NetworkMode": "awsvpc",
        "ExecutionRoleArn": {
          "Fn::ImportValue": "ECRdevtoassetsAccessRole"
        },
        "RuntimePlatform": {
          "OperatingSystemFamily": "LINUX",
          "CpuArchitecture": "X86_64"
        },
        "Volumes": [
          {
            "Name": "log"
          }
        ],
        "ContainerDefinitions": [
          {
            "Image": "111111111111.dkr.ecr.eu-central-1.amazonaws.com/applestore-assets-ecr-registry:latest",
            "Essential": true,
            "LogConfiguration": {
              "Options": {
                "awslogs-group": "/ecs/dev-Puma",
                "awslogs-create-group": "true",
                "awslogs-region": "eu-central-1",
                "awslogs-stream-prefix": "ecs"
              },
              "LogDriver": "awslogs"
            },
            "EnvironmentFiles": [
              {
                "Type": "s3",
                "Value": "arn:aws:s3:::applestore-dev-webapp-environmentvariables/applestore-webapp.env"
              }
            ],
            "Name": "dev-Puma-ContainerDefinition",
            "MountPoints": [
              {
                "ReadOnly": false,
                "SourceVolume": "log",
                "ContainerPath": "/webapp/log"
              }
            ],
            "PortMappings": [
              {
                "AppProtocol": "http",
                "HostPort": "3000",
                "ContainerPort": "3000",
                "Protocol": "tcp"
              }
            ]
          }
        ],
        "Family": "dev-Puma",
        "Tags": [
          {
            "Key": "Name",
            "Value": "dev-Puma"
          }
        ]
      }
    },
    "devsidekiq": {
      "Type": "AWS::ECS::TaskDefinition",
      "Properties": {
        "TaskRoleArn": {
          "Fn::ImportValue": "ECRdevtoassetsAccessRole"
        },
        "Memory": "512",
        "Cpu": "256",
        "RequiresCompatibilities": [
          "FARGATE"
        ],
        "NetworkMode": "awsvpc",
        "ExecutionRoleArn": {
          "Fn::ImportValue": "ECRdevtoassetsAccessRole"
        },
        "RuntimePlatform": {
          "OperatingSystemFamily": "LINUX",
          "CpuArchitecture": "X86_64"
        },
        "Volumes": [
          {
            "Name": "log"
          }
        ],
        "ContainerDefinitions": [
          {
            "EntryPoint": [
              "/usr/local/bin/docker-entrypoint.sh"
            ],
            "Image": "111111111111.dkr.ecr.eu-central-1.amazonaws.com/applestore-assets-ecr-registry:latest",
            "Essential": true,
            "LogConfiguration": {
              "Options": {
                "awslogs-group": "/ecs/dev-sidekiq",
                "awslogs-create-group": "true",
                "awslogs-region": "eu-central-1",
                "awslogs-stream-prefix": "ecs"
              },
              "LogDriver": "awslogs"
            },
            "EnvironmentFiles": [
              {
                "Type": "s3",
                "Value": "arn:aws:s3:::applestore-dev-webapp-environmentvariables/applestore-webapp.env"
              }
            ],
            "Name": "dev-sidekiq-ContainerDefinition",
            "MountPoints": [
              {
                "ReadOnly": false,
                "SourceVolume": "log",
                "ContainerPath": "/webapp/log"
              }
            ],
            "Command": [
              "/usr/local/bin/bundle",
              "exec",
              "sidekiq",
              "-C",
              "/webapp/config/sidekiq.yml"
            ]
          },
          {
            "EntryPoint": [
              "/usr/local/bin/docker-entrypoint.sh"
            ],
            "Image": "111111111111.dkr.ecr.eu-central-1.amazonaws.com/applestore-assets-ecr-registry:latest",
            "Essential": true,
            "LogConfiguration": {
              "Options": {
                "awslogs-group": "/ecs/dev-sidekiq",
                "awslogs-create-group": "true",
                "awslogs-region": "eu-central-1",
                "awslogs-stream-prefix": "ecs"
              },
              "LogDriver": "awslogs"
            },
            "EnvironmentFiles": [
              {
                "Type": "s3",
                "Value": "arn:aws:s3:::applestore-dev-webapp-environmentvariables/applestore-webapp.env"
              }
            ],
            "Name": "dev-sidekiq-export-ContainerDefinition",
            "MountPoints": [
              {
                "ReadOnly": false,
                "SourceVolume": "log",
                "ContainerPath": "/webapp/log"
              }
            ],
            "Command": [
              "/usr/local/bin/bundle",
              "exec",
              "sidekiq",
              "-C",
              "/webapp/config/sidekiq-content-export.yml"
            ]
          },
          {
            "EntryPoint": [
              "/usr/local/bin/docker-entrypoint.sh"
            ],
            "Image": "111111111111.dkr.ecr.eu-central-1.amazonaws.com/applestore-assets-ecr-registry:latest",
            "Essential": true,
            "LogConfiguration": {
              "Options": {
                "awslogs-group": "/ecs/dev-sidekiq",
                "awslogs-create-group": "true",
                "awslogs-region": "eu-central-1",
                "awslogs-stream-prefix": "ecs"
              },
              "LogDriver": "awslogs"
            },
            "EnvironmentFiles": [
              {
                "Type": "s3",
                "Value": "arn:aws:s3:::applestore-dev-webapp-environmentvariables/applestore-webapp.env"
              }
            ],
            "Name": "dev-sidekiq-duplication-high-priority-ContainerDefinition",
            "MountPoints": [
              {
                "ReadOnly": false,
                "SourceVolume": "log",
                "ContainerPath": "/webapp/log"
              }
            ],
            "Command": [
              "/usr/local/bin/bundle",
              "exec",
              "sidekiq",
              "-C",
              "/webapp/config/sidekiq-duplication-high-priority.yml"
            ]
          },
          {
            "EntryPoint": [
              "/usr/local/bin/docker-entrypoint.sh"
            ],
            "Image": "111111111111.dkr.ecr.eu-central-1.amazonaws.com/applestore-assets-ecr-registry:latest",
            "Essential": true,
            "LogConfiguration": {
              "Options": {
                "awslogs-group": "/ecs/dev-sidekiq",
                "awslogs-create-group": "true",
                "awslogs-region": "eu-central-1",
                "awslogs-stream-prefix": "ecs"
              },
              "LogDriver": "awslogs"
            },
            "EnvironmentFiles": [
              {
                "Type": "s3",
                "Value": "arn:aws:s3:::applestore-dev-webapp-environmentvariables/applestore-webapp.env"
              }
            ],
            "Name": "dev-sidekiq-duplication-low-priority-ContainerDefinition",
            "MountPoints": [
              {
                "ReadOnly": false,
                "SourceVolume": "log",
                "ContainerPath": "/webapp/log"
              }
            ],
            "Command": [
              "/usr/local/bin/bundle",
              "exec",
              "sidekiq",
              "-C",
              "/webapp/config/sidekiq-duplication-low-priority.yml"
            ]
          }
        ],
        "Family": "dev-sidekiq",
        "Tags": [
          {
            "Key": "Name",
            "Value": "dev-sidekiq"
          }
        ]
      }
    },
    "ecsdevPuma": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "KmsKeyId": {
          "Fn::Sub": "arn:aws:kms:${AWS::Region}:${AWS::AccountId}:alias/KMS-dev-CMK"
        },
        "LogGroupName": "/ecs/dev-Puma",
        "Tags": [
          {
            "Key": "Name",
            "Value": "/ecs/dev-Puma"
          }
        ]
      }
    },
    "ecsdevsidekiq": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "KmsKeyId": {
          "Fn::Sub": "arn:aws:kms:${AWS::Region}:${AWS::AccountId}:alias/KMS-dev-CMK"
        },
        "LogGroupName": "/ecs/dev-sidekiq",
        "Tags": [
          {
            "Key": "Name",
            "Value": "/ecs/dev-sidekiq"
          }
        ]
      }
    }
  }
}