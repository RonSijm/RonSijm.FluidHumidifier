  "Description": "CloudFormation Stack For ECS Services For dev Environment",
  "Resources": {
    "AppleStoredevpuma": {
      "Type": "AWS::ECS::Service",
      "Properties": {
        "PlatformVersion": "1.4.0",
        "EnableExecuteCommand": true,
        "Cluster": {
          "Ref": "AppleStoredevCluster"
        },
        "LoadBalancers": [
          {
            "TargetGroupArn": {
              "Fn::ImportValue": "AppleStorePumaLBdevLBTG"
            },
            "ContainerName": "dev-puma-ContainerDefinition",
            "ContainerPort": 3000
          }
        ],
        "DesiredCount": 1,
        "DeploymentController": {
          "Type": "ECS"
        },
        "CapacityProviderStrategy": [
          {
            "CapacityProvider": "FARGATE",
            "Weight": 1
          }
        ],
        "SchedulingStrategy": "REPLICA",
        "TaskDefinition": {
          "Ref": "devpumadevTaskDefinition"
        },
        "ServiceName": "AppleStore-dev-puma",
        "NetworkConfiguration": {
          "AwsvpcConfiguration": {
            "SecurityGroups": [
              {
                "Fn::ImportValue": "DockerSecurityGroup"
              }
            ],
            "Subnets": [
              {
                "Fn::ImportValue": "DockerSubnetAZA"
              },
              {
                "Fn::ImportValue": "DockerSubnetAZB"
              },
              {
                "Fn::ImportValue": "DockerSubnetAZC"
              }
            ],
            "AssignPublicIp": "ENABLED"
          }
        },
        "Tags": [
          {
            "Key": "Name",
            "Value": "AppleStore-dev-puma"
          }
        ],
        "DeploymentConfiguration": {
          "DeploymentCircuitBreaker": {
            "Enable": false,
            "Rollback": false
          },
          "MaximumPercent": 200,
          "MinimumHealthyPercent": 100
        }
      }
    },
