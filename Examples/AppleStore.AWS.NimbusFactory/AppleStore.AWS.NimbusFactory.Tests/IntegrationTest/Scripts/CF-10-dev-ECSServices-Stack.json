    "devpumadevTaskDefinition": {
      "Type": "AWS::ECS::TaskDefinition",
      "Properties": {
        "TaskRoleArn": {
          "Fn::ImportValue": "ECRdevtoassetsAccessRole"
        },
        "Memory": "3072",
        "Cpu": "1024",
        "RequiresCompatibilities": [
          "FARGATE"
        ],
        "NetworkMode": "awsvpc",
        "ExecutionRoleArn": {
          "Fn::ImportValue": "ECRdevtoassetsAccessRole"
        },
        "RuntimePlatform": {
          "OperatingSystemFamily": "LINUX",
          "CpuArchitecture": "X86_64"
        },
        "Volumes": [
          {
            "Name": "log"
          }
        ],
        "ContainerDefinitions": [
          {
            "HealthCheck": {
              "Command": [
                "CMD-SHELL",
                "exit 0"
              ],
              "Timeout": 30,
              "Retries": 3,
              "Interval": 30,
              "StartPeriod": 1
            },
            "Image": "111111111111.dkr.ecr.eu-central-1.amazonaws.com/applestore-assets-ecr-registry:latest",
            "Essential": true,
            "LogConfiguration": {
              "Options": {
                "awslogs-group": "/ecs/dev-puma",
                "awslogs-create-group": "true",
                "awslogs-region": "eu-central-1",
                "awslogs-stream-prefix": "ecs"
              },
              "LogDriver": "awslogs"
            },
            "EnvironmentFiles": [
              {
                "Type": "s3",
                "Value": "arn:aws:s3:::applestore-dev-webapp-environmentvariables/applestore-webapp.env"
              }
            ],
            "Name": "dev-puma-ContainerDefinition",
            "MountPoints": [
              {
                "ReadOnly": false,
                "SourceVolume": "log",
                "ContainerPath": "/webapp/log"
              }
            ],
            "PortMappings": [
              {
                "AppProtocol": "http",
                "HostPort": "3000",
                "ContainerPort": "3000",
                "Protocol": "tcp"
              }
            ]
          }
        ],
        "Family": "dev-puma",
        "Tags": [
          {
            "Key": "Name",
            "Value": "dev-puma-dev-TaskDefinition"
          }
        ]
      }
    },
