{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "CloudFormation Stack For Cloudformation Resources For dev Environment",
  "Resources": {
    "devSlackLoggerPolicy": {
      "Type": "AWS::IAM::ManagedPolicy",
      "Properties": {
        "ManagedPolicyName": "dev-SlackLogger-Policy",
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "AllowCreateLogGroup",
              "Effect": "Allow",
              "Action": [
                "logs:CreateLogGroup"
              ],
              "Resource": {
                "Fn::Sub": "arn:aws:logs:${AWS::Region}:${AWS::AccountId}:*"
              }
            },
            {
              "Effect": "Allow",
              "Action": [
                "logs:CreateLogGroup",
                "logs:CreateLogStream",
                "logs:PutLogEvents"
              ],
              "Resource": {
                "Fn::Sub": "arn:aws:logs:${AWS::Region}:${AWS::AccountId}:log-group:/aws/lambda/*"
              }
            }
          ]
        }
      }
    },
    "devSlackLogger": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "ManagedPolicyArns": [
          {
            "Ref": "devSlackLoggerPolicy"
          }
        ],
        "MaxSessionDuration": 3600,
        "RoleName": "dev-SlackLogger",
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": [
                "sts:AssumeRole"
              ]
            }
          ]
        },
        "Tags": [
          {
            "Key": "Name",
            "Value": "dev-SlackLogger"
          }
        ]
      }
    },
    "awsdevcloudformationapplestore": {
      "Type": "AWS::S3::Bucket",
      "Properties": {
        "BucketName": "aws-dev-cloudformation-applestore",
        "Tags": [
          {
            "Key": "Name",
            "Value": "aws-dev-cloudformation-applestore"
          }
        ]
      }
    },
    "applestoredevwebappenvironmentvariables": {
      "Type": "AWS::S3::Bucket",
      "Properties": {
        "BucketName": "applestore-dev-webapp-environmentvariables",
        "Tags": [
          {
            "Key": "Name",
            "Value": "AppleStore-dev-webapp-environmentvariables"
          }
        ]
      }
    },
    "applestoresysopsdevTopic": {
      "Type": "AWS::SNS::Topic",
      "Properties": {
        "DisplayName": "applestore-sysops-dev",
        "Tags": [
          {
            "Key": "Name",
            "Value": "applestore-sysops-dev-Topic"
          }
        ],
        "TopicName": "applestore-sysops-dev-Topic"
      }
    },
    "applestoresysopsdevTopicPolicy": {
      "Type": "AWS::SNS::TopicPolicy",
      "Properties": {
        "Topics": [
          {
            "Ref": "applestoresysopsdevTopic"
          }
        ],
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "AllowSNS",
              "Effect": "Allow",
              "Principal": {
                "AWS": "*"
              },
              "Action": [
                "SNS:Publish",
                "SNS:SetTopicAttributes",
                "SNS:AddPermission",
                "SNS:RemovePermission",
                "SNS:DeleteTopic",
                "SNS:Subscribe",
                "SNS:ListSubscriptionsByTopic",
                "SNS:Publish",
                "SNS:Receive"
              ],
              "Resource": {
                "Ref": "applestoresysopsdevTopic"
              },
              "Condition": {
                "StringEquals": {
                  "AWS:SourceOwner": {
                    "Fn::Sub": "${AWS::AccountId}"
                  }
                }
              }
            },
            {
              "Sid": "AllowCloudtrail",
              "Effect": "Allow",
              "Principal": {
                "Service": "cloudtrail.amazonaws.com"
              },
              "Action": [
                "SNS:Publish"
              ],
              "Resource": {
                "Ref": "applestoresysopsdevTopic"
              }
            }
          ]
        }
      }
    }
  },
  "Outputs": {
    "devSlackLogger": {
      "Value": {
        "Ref": "devSlackLogger"
      },
      "Export": {
        "Name": {
          "Fn::Sub": "devSlackLogger"
        }
      }
    },
    "awsdevcloudformationapplestore": {
      "Value": {
        "Ref": "awsdevcloudformationapplestore"
      },
      "Export": {
        "Name": {
          "Fn::Sub": "awsdevcloudformationapplestore"
        }
      }
    },
    "applestoredevwebappenvironmentvariables": {
      "Value": {
        "Ref": "applestoredevwebappenvironmentvariables"
      },
      "Export": {
        "Name": {
          "Fn::Sub": "applestoredevwebappenvironmentvariables"
        }
      }
    },
    "applestoresysopsdevTopic": {
      "Value": {
        "Ref": "applestoresysopsdevTopic"
      },
      "Export": {
        "Name": {
          "Fn::Sub": "applestoresysopsdevTopic"
        }
      }
    }
  }
}